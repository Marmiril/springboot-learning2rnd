PATCH {{baseUrl}}/1
Content-Type: application/json

{
    "notes": "Updated notes using PATCH."
}


### 36 - PATCH both fields - 200 OK
PATCH {{baseUrl}}/1
Content-Type: application/json

{
    "price": 21.50,
    "notes": "Both fields updated."
}


### 37 - PATCH nonexistent book - 404 Not Found
PATCH {{baseUrl}}/9999
Content-Type: application/json

{
    "price": 15.00
}


### 38 - PATCH empty JSON - 400 Bad Request
PATCH {{baseUrl}}/1
Content-Type: application/json

{}


### 39 - PATCH invalid price - 400 Bad Request
PATCH {{baseUrl}}/1
Content-Type: application/json

{
    "price": 0
}


### 40 - PATCH empty notes - 400 Bad Request
PATCH {{baseUrl}}/1
Content-Type: application/json

{
    "notes": ""
}


### ============================================================
### DELETE - ERROR CASES
### Execute these before successful deletions.
### ============================================================


### 41 - Delete nonexistent book by ID - 404 Not Found
DELETE {{baseUrl}}/9999


### 42 - Delete nonexistent book by title - 404 Not Found
DELETE {{baseUrl}}?title=UnknownBook


### 43 - Delete by empty title - 400 Bad Request
DELETE {{baseUrl}}?title=


### 44 - Delete books by nonexistent author - 404 Not Found
DELETE {{baseUrl}}?author=UnknownAuthor


### 45 - Delete books by invalid theme - 400 Bad Request
DELETE {{baseUrl}}?theme=COMEDY


### 46 - Delete books from future year - 400 Bad Request
DELETE {{baseUrl}}?year=2099


### 47 - Delete book with mismatched details - 404 Not Found
DELETE {{baseUrl}}?title=Dune&author=Wrong%20Author&theme=SCIENCE_FICTION&year=1965


### ============================================================
### DELETE - SUCCESSFUL REQUESTS
### Execute these LAST and in the order shown.
### ============================================================


### 48 - Delete Dune by title - 200 OK
DELETE {{baseUrl}}?title=Dune


### 49 - Delete books by author - 200 OK
### Removes Foundation and I, Robot.
DELETE {{baseUrl}}?author=Isaac%20Asimov


### 50 - Delete books by theme - 200 OK
### Removes Dracula.
DELETE {{baseUrl}}?theme=HORROR


### 51 - Delete books by year - 200 OK
### Removes The Hobbit.
DELETE {{baseUrl}}?year=1937


