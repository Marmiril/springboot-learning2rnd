### ============================================================
### POST - ERROR CASES
### ============================================================


### 06 - Duplicate title - 409 Conflict
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "Dune",
    "author": "Another Author",
    "theme": "FANTASY",
    "year": 2000,
    "price": 20.00,
    "notes": "Duplicate title test."
}


### 07 - Empty title - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "",
    "author": "Frank Herbert",
    "theme": "SCIENCE_FICTION",
    "year": 1965,
    "price": 19.99,
    "notes": "Invalid title."
}


### 08 - Empty author - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "Invalid Author Book",
    "author": "",
    "theme": "OTHER",
    "year": 2020,
    "price": 10.00,
    "notes": "Invalid author."
}


### 09 - Invalid enum value - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "Invalid Theme Book",
    "author": "Test Author",
    "theme": "COMEDY",
    "year": 2020,
    "price": 10.00,
    "notes": "Invalid genre."
}


### 10 - Future publication year - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "Future Book",
    "author": "Test Author",
    "theme": "OTHER",
    "year": 2099,
    "price": 10.00,
    "notes": "Invalid publication year."
}


### 11 - Negative price - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "Negative Price Book",
    "author": "Test Author",
    "theme": "OTHER",
    "year": 2020,
    "price": -5.00,
    "notes": "Invalid price."
}


### 12 - Empty notes - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "Empty Notes Book",
    "author": "Test Author",
    "theme": "OTHER",
    "year": 2020,
    "price": 12.00,
    "notes": ""
}


### 13 - Missing theme - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{
    "title": "Missing Theme Book",
    "author": "Test Author",
    "year": 2020,
    "price": 12.00,
    "notes": "Missing enum value."
}


### 14 - Empty JSON object - 400 Bad Request
POST {{baseUrl}}
Content-Type: application/json

{}


### ============================================================
### GET - SUCCESSFUL REQUESTS
### ============================================================


### 15 - Get all books - 200 OK
GET {{baseUrl}}


### 16 - Get book by ID - 200 OK
GET {{baseUrl}}/1


### 17 - Get books by title - 200 OK
GET {{baseUrl}}?title=Dune


### 18 - Get books by author - 200 OK
GET {{baseUrl}}?author=Isaac%20Asimov


### 19 - Get books by theme - 200 OK
GET {{baseUrl}}?theme=SCIENCE_FICTION


### 20 - Get books by year - 200 OK
GET {{baseUrl}}?year=1951


### 21 - Get books by multiple filters - 200 OK
GET {{baseUrl}}?author=Isaac%20Asimov&theme=SCIENCE_FICTION


### 22 - Get book by all details - 200 OK
GET {{baseUrl}}?title=Dune&author=Frank%20Herbert&theme=SCIENCE_FICTION&year=1965


### ============================================================
### GET - ERROR AND EMPTY RESULT CASES
### ============================================================


### 23 - Missing book by ID - 404 Not Found
GET {{baseUrl}}/9999


### 24 - No books match title - 200 OK (empty list)
GET {{baseUrl}}?title=UnknownBook


### 25 - Empty title filter - 400 Bad Request
GET {{baseUrl}}?title=


### 26 - Invalid enum filter - 400 Bad Request
GET {{baseUrl}}?theme=COMEDY


### 27 - Future year filter - 400 Bad Request
GET {{baseUrl}}?year=2099


### 28 - Multiple filters with no matches - 200 OK (empty list)
GET {{baseUrl}}?author=Isaac%20Asimov&theme=HORROR


### ============================================================
### PUT - FULL UPDATE OF EDITABLE FIELDS
### ============================================================


### 29 - Update book by ID - 200 OK
PUT {{baseUrl}}/1
Content-Type: application/json

{
    "price": 24.99,
    "notes": "Updated edition of Dune."
}


### 30 - Update nonexistent book - 404 Not Found
PUT {{baseUrl}}/9999
Content-Type: application/json

{
    "price": 20.00,
    "notes": "Missing book test."
}


### 31 - PUT without price - 400 Bad Request
PUT {{baseUrl}}/1
Content-Type: application/json

{
    "notes": "Missing price."
}


### 32 - PUT without notes - 400 Bad Request
PUT {{baseUrl}}/1
Content-Type: application/json

{
    "price": 20.00
}


### 33 - PUT with negative price - 400 Bad Request
PUT {{baseUrl}}/1
Content-Type: application/json

{
    "price": -10.00,
    "notes": "Invalid price."
}


### ============================================================
### PATCH - PARTIAL UPDATE
### ============================================================


